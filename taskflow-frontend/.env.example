# Base URL of the TaskFlow API (no trailing slash).
# Local backend:   http://localhost:3000
# Public demo API: https://taskflow-backend-api-7iwy.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Firebase web app configuration (required for Firebase sign-in and registration).
# Copy these public values from the Firebase web app for your development project.
# They must use the same Firebase project as the backend's FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=your-development-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-development-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-development-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-development-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-development-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-development-firebase-app-id

# Optional: show one-click demo sign-in buttons on the login page.
# Uses the accounts created by the backend's `prisma/seed.ts`.
NEXT_PUBLIC_DEMO_MODE=true
# Password of the seeded demo users (see the backend README / seed file).
NEXT_PUBLIC_DEMO_PASSWORD=

# Optional: set to "true" only if a BullMQ worker is attached to the API you point at.
# When "false", the Notifications page explains why jobs stay in "pending".
NEXT_PUBLIC_WORKER_DEPLOYED=false
