# Base URL of the TaskFlow API (no trailing slash).
# Local backend:   http://localhost:3000
# Public demo API: https://taskflow-backend-api-7iwy.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: show one-click demo sign-in buttons on the login page.
# Uses the accounts created by the backend's `prisma/seed.ts`.
NEXT_PUBLIC_DEMO_MODE=true
# Password of the seeded demo users (see the backend README / seed file).
NEXT_PUBLIC_DEMO_PASSWORD=

# Optional: set to "true" only if a BullMQ worker is attached to the API you point at.
# When "false", the Notifications page explains why jobs stay in "pending".
NEXT_PUBLIC_WORKER_DEPLOYED=false
