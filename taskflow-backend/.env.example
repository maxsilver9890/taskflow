# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://taskflow:change_me@localhost:5433/taskflow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Optional — defaults shown
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# BCRYPT_ROUNDS=12

# ── Application ───────────────────────────────────────────────────────────────
# NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ── Email provider ────────────────────────────────────────────────────────────
# Supported values:
#   console  — log emails to stdout (default; use for local development & tests)
#   resend   — send real emails via the Resend API (use for staging & production)
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=resend:
#   Obtain your API key from https://resend.com/api-keys
#   The from address must be a verified domain or address in your Resend account.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_ADDRESS=TaskFlow <noreply@yourdomain.com>
