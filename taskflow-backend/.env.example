# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://taskflow:change_me@localhost:5433/taskflow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Optional — defaults shown
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# BCRYPT_ROUNDS=12

# ── Application ───────────────────────────────────────────────────────────────
# NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ── Email provider ────────────────────────────────────────────────────────────
# Supported values:
#   console  — log emails to stdout (default; use for local development & tests)
#   resend   — send real emails via the Resend API (use for staging & production)
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=resend:
#   Obtain your API key from https://resend.com/api-keys
#   The from address must be a verified domain or address in your Resend account.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_ADDRESS=TaskFlow <noreply@yourdomain.com>

# Firebase Admin SDK (required for Firebase ID-token exchange)
# Use credentials from the same nonproduction Firebase project as the frontend.
# Keep these backend-only; never use NEXT_PUBLIC_ for service-account credentials.
# FIREBASE_PROJECT_ID=your-development-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxxxxx@your-development-project-id.iam.gserviceaccount.com
# Store the private key with escaped newline sequences; the backend converts them to real line breaks.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_contents\n-----END PRIVATE KEY-----\n"
