# ── Test database (separate from development) ─────────────────────────────────
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://taskflow:change_me@localhost:5433/taskflow_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=test_jwt_secret_not_for_production
JWT_REFRESH_SECRET=test_jwt_refresh_secret_not_for_production

# ── Email provider ────────────────────────────────────────────────────────────
# Always use console in tests — never send real emails.
EMAIL_PROVIDER=console
# RESEND_API_KEY and RESEND_FROM_ADDRESS are intentionally omitted for tests.
