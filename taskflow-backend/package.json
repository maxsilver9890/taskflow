{
  "name": "taskflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stage 1 foundation for the TaskFlow backend assignment.",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/server.ts",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker": "node dist/worker/worker.js",
    "worker:dev": "tsx watch worker/worker.ts",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest run",
    "test:watch": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest",
    "test:coverage": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest run --coverage",
    "test:unit": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest run tests/unit",
    "test:integration": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest run tests/integration",
    "lint": "eslint .",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.0.0",
    "resend": "^6.32.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "prisma": "^6.15.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.0.0"
  }
}
